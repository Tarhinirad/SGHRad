# Copy to .env and change these before deploying.
ADMIN_PASSWORD=change-me-admin
VIEWER_PASSWORD=change-me-residents
# Random string used to sign login tokens (generated and stored in the DB if omitted).
SESSION_SECRET=
PORT=3001
# SQLite file location (default: data/sghrad.db)
# DB_FILE=/var/lib/sgumc-schedule/sghrad.db
# Time zone used for "today"
TZ_NAME=Asia/Beirut
# Set to false to start with an empty database instead of sample data
SEED_ON_EMPTY=true
# Free hosting: Postgres connection string (e.g. neon.tech). When set, the database is kept in
# memory and a snapshot is saved to Postgres after every change (DB_FILE is then ignored).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Set to true to require VIEWER_PASSWORD for viewing (default: viewing is public, editing needs ADMIN_PASSWORD)
# REQUIRE_LOGIN_TO_VIEW=false
